# Root Environment Reference
# Note: server/.env and client/.env hold respective application configs.

# Server Configuration
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/autox_db
CLIENT_URL=http://localhost:5173

# Security & Authentication
JWT_SECRET=autox_super_secure_jwt_secret_key_2026_xyz987
JWT_EXPIRES_IN=7d
COOKIE_SECRET=autox_secure_cookie_secret_key_2026_abc123

# Initial Administrator Seed Credentials
ADMIN_NAME="AUTOX Admin"
ADMIN_EMAIL=admin@autox.pk
ADMIN_PASSWORD=Admin@AutoX2026!

# Upload & Storage Config
UPLOAD_MAX_SIZE=10485760
STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Mail Transport (Optional development fallback provided)
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@autox.pk

# Client Configuration
VITE_API_URL=http://localhost:5000/api/v1
