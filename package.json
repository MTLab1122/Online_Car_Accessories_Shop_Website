{
  "name": "autox-online-car-accessories-shop",
  "version": "1.0.0",
  "description": "AUTOX — 3D Immersive Online Car Accessories Shop (FYP MERN Project)",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"npm run server\" \"npm run client\"",
    "client": "npm --prefix client run dev",
    "server": "npm --prefix server run dev",
    "seed": "npm --prefix server run seed",
    "test": "npm --prefix server test",
    "test:client": "npm --prefix client test",
    "test:all": "npm --prefix server test && npm --prefix client test",
    "test:e2e": "playwright test --project=\"Desktop Chromium\"",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "test:e2e:mobile": "playwright test --project=\"Mobile iPhone 14\"",
    "test:e2e:showroom": "playwright test e2e/tests/showroom.spec.js",
    "test:e2e:all": "playwright test",
    "build": "npm --prefix client run build",
    "lint": "npm --prefix client run lint && npm --prefix server run lint",
    "install:all": "npm install && cd server && npm install && cd ../client && npm install"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "concurrently": "^9.1.2",
    "playwright": "^1.64.1"
  },
  "keywords": [
    "mern",
    "threejs",
    "ecommerce",
    "car-accessories",
    "autox",
    "fyp",
    "react-three-fiber"
  ],
  "author": "AUTOX Team",
  "license": "ISC"
}
